---
// UWAGA: ContactForm.astro celowo NIE jest tu używany — formularz działa w trybie demo i nie
// dostarcza leada. Do czasu integracji z Fatica ERP prezentujemy kontakt bezpośredni.
// Nie usuwać komponentu src/components/ContactForm.astro — pozostaje do integracji.
import BaseLayout from '../layouts/BaseLayout.astro';
import { contact } from '../data/site';
---

<BaseLayout
  title="Kontakt"
  description="Skontaktuj się z Panelia Studio i umów niezobowiązującą konsultację telefonicznie lub e-mailowo."
  path="/kontakt"
  headerVariant="overlay-dark"
>
  <section class="contact section-dark">
    <span class="contact-bgword" aria-hidden="true">POROZMAWIAJMY</span>

    <div class="container contact-inner">
      <div class="contact-left">
        <div class="contact-left-sticky" data-reveal>
          <p class="eyebrow">Kontakt</p>
          <h1 class="contact-title">Porozmawiajmy<br />o Twoim <span class="gold">wnętrzu</span></h1>
          <p class="lead contact-lead">
            Umów niezobowiązującą konsultację. Odpowiemy na pytania i podpowiemy, jak możemy
            poprowadzić Twój projekt.
          </p>

          <div class="contact-details">
            <a href={`tel:${contact.phoneHref}`} class="contact-detail">
              <span class="contact-detail-label">Telefon</span>
              <span class="contact-detail-value">{contact.phone}</span>
            </a>
            <a href={`mailto:${contact.email}`} class="contact-detail">
              <span class="contact-detail-label">E-mail</span>
              <span class="contact-detail-value">{contact.email}</span>
            </a>
            <div class="contact-detail">
              <span class="contact-detail-label">Adres</span>
              <address class="contact-detail-value">
                {contact.address.street}, {contact.address.postalCode} {contact.address.city}
              </address>
            </div>
          </div>
        </div>
      </div>

      <div class="contact-right" data-reveal style="--reveal-delay: 120ms">
        <div class="contact-direct-panel">
          <p class="eyebrow">Kontakt bezpośredni</p>
          <h2 class="contact-direct-title">Porozmawiajmy o Twoim projekcie.</h2>
          <p class="muted contact-direct-intro">
            Najszybciej skontaktujesz się z nami telefonicznie lub e-mailowo. Formularz online
            uruchomimy po zakończeniu integracji.
          </p>

          <div class="contact-direct-actions">
            <a href={`tel:${contact.phoneHref}`} class="contact-cta">
              <span class="contact-cta-label">Zadzwoń</span>
              <span class="contact-cta-value">{contact.phone}</span>
            </a>
            <a href={`mailto:${contact.email}`} class="contact-cta">
              <span class="contact-cta-label">Napisz</span>
              <span class="contact-cta-value">{contact.email}</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact {
    position: relative;
    overflow: hidden;
    padding-block: clamp(112px, 13vw, 190px) clamp(88px, 12vw, 170px);
  }

  /* Gigantyczny, przycięty napis dekoracyjny w tle */
  .contact-bgword {
    position: absolute;
    left: -0.06em;
    bottom: -0.14em;
    z-index: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(4.5rem, 19vw, 21rem);
    line-height: 0.8;
    letter-spacing: -0.05em;
    color: transparent;
    -webkit-text-stroke: 1px rgba(243, 239, 230, 0.1);
    white-space: nowrap;
    pointer-events: none;
    user-select: none;
    max-width: 100%;
    overflow: hidden;
  }

  .contact-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 480px;
    gap: clamp(36px, 5vw, 88px);
    align-items: start;
  }
  @media (max-width: 1080px) { .contact-inner { grid-template-columns: 1fr; } }

  .contact-title {
    color: #fff;
    font-size: clamp(2.6rem, 5vw, 4.75rem);
    line-height: 0.98;
    margin-bottom: 1.6rem;
  }
  .contact-lead { color: var(--on-dark); max-width: 40ch; }

  .contact-details {
    margin-top: clamp(32px, 4vw, 52px);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .contact-detail {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 20px 0;
    border-top: 1px solid rgba(243, 239, 230, 0.14);
  }
  .contact-detail:last-child { border-bottom: 1px solid rgba(243, 239, 230, 0.14); }
  .contact-detail-label {
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--on-dark-gold);
  }
  .contact-detail-value { font-size: clamp(1.15rem, 1.6vw, 1.5rem); font-weight: 600; color: var(--on-dark); font-style: normal; }
  a.contact-detail:hover .contact-detail-value { color: var(--gold); }

  .contact-direct-panel {
    background: var(--surface);
    border-radius: var(--radius-lg);
    padding: clamp(30px, 3vw, 46px);
    box-shadow: var(--shadow-soft);
  }
  .contact-direct-panel .eyebrow { color: var(--accent-deep); }
  .contact-direct-title {
    color: var(--ink);
    font-size: clamp(1.7rem, 2.6vw, 2.4rem);
    margin: 0.7rem 0 0.9rem;
  }
  .contact-direct-intro { color: var(--ink-90); margin-bottom: clamp(24px, 3vw, 34px); max-width: 42ch; }

  .contact-direct-actions { display: flex; flex-direction: column; gap: 14px; }
  .contact-cta {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: clamp(16px, 2vw, 22px) clamp(18px, 2.2vw, 26px);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--surface);
    transition: border-color 0.2s ease, background-color 0.2s ease, transform 0.2s ease;
  }
  .contact-cta:hover {
    border-color: var(--gold);
    background: color-mix(in srgb, var(--gold) 8%, var(--surface));
    transform: translateY(-2px);
  }
  .contact-cta:focus-visible {
    outline: 2px solid var(--accent-deep);
    outline-offset: 3px;
  }
  .contact-cta-label {
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--accent-deep);
  }
  .contact-cta-value {
    font-size: clamp(1.15rem, 1.9vw, 1.55rem);
    font-weight: 700;
    color: var(--ink);
    letter-spacing: -0.01em;
  }
  .contact-cta:hover .contact-cta-value { color: var(--accent-deep); }

  /* Sticky formularza — tylko na wysokich ekranach desktopowych, z bezpiecznym offsetem
     pod headerem. Na niższych/tabletach/mobile: normalny układ dokumentu. */
  @media (min-width: 1081px) and (min-height: 900px) {
    .contact-right { position: sticky; top: calc(var(--header-height) + 32px); }
  }

  /* Napis dekoracyjny mniejszy i subtelniejszy na mobile */
  @media (max-width: 640px) {
    .contact-bgword {
      font-size: clamp(3.5rem, 26vw, 7rem);
      -webkit-text-stroke-color: rgba(243, 239, 230, 0.08);
      bottom: -0.08em;
    }
  }
</style>
