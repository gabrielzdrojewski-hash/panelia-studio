---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Strona nie została znaleziona"
  description="Nie znaleziono strony. Wróć na stronę główną Panelia Studio."
  path="/404"
  noindex={true}
>
  <section class="section error-page">
    <div class="container container-narrow error-inner">
      <p class="eyebrow">Błąd 404</p>
      <h1>Nie znaleźliśmy tej strony</h1>
      <p class="lead muted">
        Strona mogła zostać przeniesiona lub nie istnieje. Zajrzyj na stronę główną albo
        skorzystaj z nawigacji.
      </p>
      <div class="error-actions">
        <a href="/" class="btn">Strona główna</a>
        <a href="/realizacje" class="btn btn-ghost">Zobacz realizacje</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .error-page {
    min-height: 58vh;
    display: flex;
    align-items: center;
    /* RC polish: padding zależny od wysokości ekranu — mieści się na laptopach 768–900px */
    padding-block: clamp(48px, 8vh, 104px);
  }
  .error-inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem; /* RC polish: ciaśniejszy rytm eyebrow→H1→opis→CTA */
  }
  /* RC polish: −~16% skali H1 (124→104px @1920) */
  .error-inner h1 { font-size: clamp(2.4rem, 6vw, 6.5rem); }
  .error-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 0.8rem;
  }
</style>
