---
import BaseLayout from '../layouts/BaseLayout.astro';
import MediaImage from '../components/MediaImage.astro';
import Counters from '../components/Counters.astro';
import ServicesSlider from '../components/ServicesSlider.astro';
import VideoReel from '../components/VideoReel.astro';
import PackageCard from '../components/PackageCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getMediaById } from '../lib/media';
import { getEditorial, editorialSrcset } from '../data/editorialMedia';
import { designPackages, finishPackages } from '../data/packages';
import { projects } from '../data/projects';
import { investor, homeStats, heroSlides as heroSlideDefs } from '../data/content';
import { contact } from '../data/site';

// Hero — slider zróżnicowanych kadrów. Pierwszy: reprezentacyjny salon katedralny (koncepcja 4K),
// dalej jasny salon otwarty (koncepcja) i wizualizacja projektu Ustronie. Dane z src/data/content.ts.
const heroSlides = heroSlideDefs
  .map((def) => {
    if (def.source === 'editorial') {
      const m = getEditorial(def.id);
      if (!m) return null;
      return { ...def, src: m.src, srcset: editorialSrcset(m), width: m.width, height: m.height, alt: m.alt };
    }
    const it = getMediaById(def.id);
    if (!it) return null;
    return { ...def, src: it.path, srcset: undefined as string | undefined, width: it.width, height: it.height, alt: it.alt };
  })
  .filter((s): s is NonNullable<typeof s> => s !== null);

const firstSlide = heroSlides[0];

// Sekcja redakcyjna.
const editorialTall = getMediaById('visualization-ustronie-02')!;
const editorialWide = getMediaById('visualization-ustronie-09')!;

const featuredProject = projects[0];
---

<BaseLayout
  title="Start"
  path="/"
  headerVariant="overlay"
  preloadImage={firstSlide
    ? { href: firstSlide.src, srcset: firstSlide.srcset, sizes: '100vw' }
    : undefined}
>
  <!-- HERO -->
  <section class="hero" data-hero>
    <div class="hero-slides">
      {
        heroSlides.map((slide, index) => (
          <div
            class="hero-slide"
            data-hero-slide
            data-active={index === 0 ? '' : undefined}
            data-overlay={slide.overlayStrength}
          >
            <img
              src={slide.src}
              srcset={slide.srcset}
              sizes="100vw"
              alt={index === 0 ? slide.alt : ''}
              width={slide.width}
              height={slide.height}
              loading={index === 0 ? 'eager' : 'lazy'}
              fetchpriority={index === 0 ? 'high' : undefined}
              decoding="async"
              style={`object-position: ${slide.focalPoint}`}
              aria-hidden={index === 0 ? undefined : 'true'}
            />
            <span class="hero-slide-overlay" aria-hidden="true" />
            <span class="hero-slide-label">{slide.publicLabel}</span>
          </div>
        ))
      }
    </div>

    <div class="container hero-content">
      <p class="hero-eyebrow" data-reveal>Projekt • Materiały • Realizacja</p>
      <h1 class="hero-title" data-reveal style="--reveal-delay: 90ms">
        Piękne wnętrza <span class="gold">— bez kompromisów.</span>
      </h1>
      <div class="hero-actions" data-reveal style="--reveal-delay: 180ms">
        <a href="/wycena" class="btn btn-gold">Wyceń swoje wnętrze</a>
        <a href="/kontakt" class="btn btn-ghost">Umów rozmowę</a>
      </div>
      <p class="hero-subline" data-reveal style="--reveal-delay: 260ms">
        Od koncepcji i dokumentacji po dobór materiałów, koordynację i realizację.
      </p>
    </div>

    {
      heroSlides.length > 1 && (
        <div class="hero-nav">
          <div class="hero-dots" role="tablist" aria-label="Slajdy hero">
            {heroSlides.map((_, index) => (
              <button
                type="button"
                class="hero-dot"
                data-hero-dot={index}
                data-active={index === 0 ? '' : undefined}
                role="tab"
                aria-label={`Slajd ${index + 1}`}
                aria-selected={index === 0 ? 'true' : 'false'}
              />
            ))}
          </div>
          <div class="hero-arrows">
            <button type="button" class="hero-arrow" data-hero-prev aria-label="Poprzedni slajd">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
            </button>
            <button type="button" class="hero-arrow" data-hero-next aria-label="Następny slajd">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
            </button>
          </div>
        </div>
      )
    }
  </section>

  <!-- SEKCJA REDAKCYJNA -->
  <section class="section section-surface">
    <div class="container editorial">
      <div class="editorial-text">
        <h2 data-reveal>
          Kształtujemy <span class="gold">wykończenia</span>.<br />
          Tworzymy ponadczasowe <span class="gold">wnętrza</span> — od projektu po realizację.
        </h2>
        <p class="lead muted editorial-lead" data-reveal style="--reveal-delay: 100ms">
          Łączymy projekt, dobór materiałów i realizację w jeden przewidywalny proces. Odpowiadamy
          za całość — od pierwszej koncepcji po gotowe, urządzone wnętrze.
        </p>
        <a href="/o-nas" class="link-arrow" data-reveal style="--reveal-delay: 160ms">Poznaj Panelia Studio</a>

        <div class="editorial-figure" data-reveal style="--reveal-delay: 220ms">
          <span class="editorial-figure-num">02</span>
          <p class="editorial-figure-desc">
            Dwie ścieżki współpracy:<br />
            <strong>projekt wnętrza</strong> oraz <strong>projekt z wykończeniem</strong>.
          </p>
        </div>
      </div>

      <div class="editorial-media">
        <figure class="editorial-tall" data-reveal>
          <MediaImage item={editorialTall} ratio="2/3" hoverable sizes="(max-width: 900px) 100vw, 34vw" />
          <figcaption class="media-caption">Wizualizacja projektowa</figcaption>
        </figure>
        <figure class="editorial-wide" data-reveal style="--reveal-delay: 120ms">
          <MediaImage item={editorialWide} ratio="3/2" hoverable sizes="(max-width: 900px) 100vw, 28vw" />
          <figcaption class="media-caption">Wizualizacja projektowa</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- LICZNIKI -->
  <section class="section-tight section-dark">
    <div class="container">
      <Counters stats={homeStats} />
    </div>
  </section>

  <!-- USŁUGI (slider) -->
  <section class="section">
    <div class="container">
      <div class="section-head split-head">
        <div data-reveal>
          <p class="eyebrow">Zakres</p>
          <h2>Poznaj nasz zakres<br />kompleksowych usług</h2>
        </div>
        <a href="/oferta" class="link-arrow" data-reveal>Pełna oferta</a>
      </div>
      <ServicesSlider />
    </div>
  </section>

  <!-- ROLKA WIDEO (poster fallback — bez działającego wideo, patrz VideoReel.astro) -->
  <VideoReel enabled={false} posterId="visualization-ustronie-04" />

  <!-- REALIZACJE -->
  <section class="section section-surface">
    <div class="container">
      <div class="section-head split-head">
        <div data-reveal>
          <p class="eyebrow">Realizacje</p>
          <h2>Wykonane wnętrza</h2>
        </div>
        <a href="/realizacje" class="link-arrow" data-reveal>Katalog realizacji</a>
      </div>
      {featuredProject && <ProjectCard project={featuredProject} index={0} />}
    </div>
  </section>

  <!-- PAKIETY -->
  <section class="section">
    <div class="container">
      <div class="section-head wide" data-reveal>
        <p class="eyebrow">Pakiety</p>
        <h2>Dwie ścieżki, sześć pakietów</h2>
        <p class="lead muted">
          Wybierz sam projekt wnętrza albo projekt połączony z wykończeniem. Bez cen na stronie —
          wyceny ustalamy indywidualnie.
        </p>
      </div>

      <div class="pkg-path" data-reveal>
        <div class="pkg-path-head">
          <span class="pkg-path-tag">Ścieżka 1</span>
          <h3>Projekt wnętrza</h3>
        </div>
        <div class="grid grid-3">
          {designPackages.map((pkg, index) => <PackageCard pkg={pkg} index={index} />)}
        </div>
      </div>

      <div class="pkg-path" data-reveal>
        <div class="pkg-path-head">
          <span class="pkg-path-tag">Ścieżka 2</span>
          <h3>Projekt i wykończenie</h3>
        </div>
        <div class="grid grid-3">
          {finishPackages.map((pkg, index) => <PackageCard pkg={pkg} index={index} />)}
        </div>
      </div>

      <div class="pkg-cta-row" data-reveal>
        <a href="/pakiety" class="btn">Porównaj pakiety</a>
        <a href="/kontakt" class="btn btn-ghost">Zapytaj o indywidualną wycenę</a>
      </div>
    </div>
  </section>

  <!-- INWESTORZY -->
  <section class="section section-dark">
    <div class="container investor">
      <div class="investor-head" data-reveal>
        <p class="eyebrow">{investor.eyebrow}</p>
        <h2>{investor.title}</h2>
      </div>
      <div class="investor-body" data-reveal style="--reveal-delay: 100ms">
        <p class="lead">{investor.description}</p>
        <ul class="investor-points">
          {investor.points.map((point) => <li>{point}</li>)}
        </ul>
        <a href="/kontakt" class="btn btn-gold">Porozmawiajmy o współpracy</a>
      </div>
    </div>
  </section>

  <!-- KOŃCOWE CTA -->
  <section class="section final-cta">
    <div class="container final-cta-inner" data-reveal>
      <div>
        <p class="eyebrow">Zaczynamy od rozmowy</p>
        <h2>Opowiedz nam<br />o swoim wnętrzu</h2>
      </div>
      <div class="final-cta-side">
        <p class="lead muted">
          Umów niezobowiązującą konsultację. Poznamy Twoje oczekiwania i podpowiemy, jak możemy
          poprowadzić projekt.
        </p>
        <div class="final-cta-actions">
          <a href="/kontakt" class="btn">Umów rozmowę</a>
          <a href={`tel:${contact.phoneHref}`} class="btn btn-ghost">{contact.phone}</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- HERO ---------- */
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    padding-block: clamp(120px, 16vh, 220px) clamp(80px, 12vh, 150px);
    color: var(--on-dark);
    overflow: hidden;
    background: var(--dark);
  }
  .hero-slides { position: absolute; inset: 0; z-index: 0; }
  .hero-slide {
    position: absolute; inset: 0;
    opacity: 0;
    transition: opacity 1.1s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .hero-slide[data-active] { opacity: 1; }
  .hero-slide img { width: 100%; height: 100%; object-fit: cover; }
  /* Overlay per slajd — siła zależna od data-overlay (czytelność H1 na jasnych kadrach) */
  .hero-slide-overlay {
    position: absolute; inset: 0;
    background:
      linear-gradient(180deg, rgba(15, 13, 9, 0.5) 0%, rgba(15, 13, 9, 0.2) 38%, rgba(15, 13, 9, 0.82) 100%),
      linear-gradient(90deg, rgba(15, 13, 9, 0.5) 0%, transparent 55%);
  }
  .hero-slide[data-overlay='soft'] .hero-slide-overlay {
    background:
      linear-gradient(180deg, rgba(15, 13, 9, 0.34) 0%, rgba(15, 13, 9, 0.12) 40%, rgba(15, 13, 9, 0.66) 100%),
      linear-gradient(90deg, rgba(15, 13, 9, 0.34) 0%, transparent 55%);
  }
  .hero-slide[data-overlay='strong'] .hero-slide-overlay {
    background:
      linear-gradient(180deg, rgba(15, 13, 9, 0.58) 0%, rgba(15, 13, 9, 0.28) 38%, rgba(15, 13, 9, 0.88) 100%),
      linear-gradient(90deg, rgba(15, 13, 9, 0.6) 0%, transparent 58%);
  }
  .hero-slide-label {
    position: absolute;
    left: var(--gutter);
    bottom: clamp(18px, 4vh, 40px);
    z-index: 2;
    padding: 5px 12px;
    font-size: 0.64rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(243, 239, 230, 0.92);
    background: rgba(20, 16, 11, 0.42);
    backdrop-filter: blur(5px);
    border-radius: 999px;
    pointer-events: none;
  }
  @media (max-width: 640px) { .hero-slide-label { display: none; } }
  .hero-content { position: relative; z-index: 1; width: 100%; }
  .hero-eyebrow {
    font-size: clamp(0.72rem, 0.9vw, 0.85rem);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--on-dark);
    margin: 0 0 1.5rem;
  }
  .hero-title {
    color: #fff;
    /* RC polish: −~11% na desktopie (124→110px @1920), mobile bez zmian */
    font-size: clamp(2.75rem, 6.4vw, 6.9rem);
    max-width: 16ch;
    text-shadow: 0 2px 50px rgba(0, 0, 0, 0.3);
  }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 2.4rem; }
  /* Hotfix: drugie CTA hero ma czarne tło już w stanie domyślnym (czytelność na zdjęciu).
     Scoped tylko do .hero-actions — nie zmienia .btn-ghost w innych sekcjach ani w headerze. */
  .hero-actions .btn-ghost {
    background: var(--ink);
    color: #fff;
    border-color: var(--ink);
  }
  .hero-actions .btn-ghost:hover {
    background: color-mix(in srgb, var(--ink) 82%, #fff);
    border-color: var(--gold);
    color: #fff;
  }
  .hero-actions .btn-ghost:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }
  .hero-subline {
    margin-top: 2rem;
    max-width: 46ch;
    font-size: clamp(1.05rem, 1.3vw, 1.25rem);
    color: rgba(243, 239, 230, 0.86);
  }

  .hero-nav {
    position: absolute;
    z-index: 2;
    right: var(--gutter);
    bottom: clamp(28px, 6vh, 64px);
    display: flex;
    align-items: center;
    gap: 22px;
  }
  .hero-dots { display: flex; gap: 10px; }
  .hero-dot {
    width: 10px; height: 10px; padding: 0;
    border-radius: 999px;
    border: 1.5px solid rgba(243, 239, 230, 0.6);
    background: transparent;
    cursor: pointer;
    transition: background-color 0.25s ease, border-color 0.25s ease, transform 0.25s ease;
  }
  .hero-dot[data-active] { background: var(--gold); border-color: var(--gold); transform: scale(1.15); }
  .hero-arrows { display: flex; gap: 10px; }
  .hero-arrow {
    width: 50px; height: 50px;
    display: inline-flex; align-items: center; justify-content: center;
    border-radius: 999px;
    border: 1.5px solid rgba(243, 239, 230, 0.4);
    background: rgba(20, 16, 11, 0.28);
    backdrop-filter: blur(6px);
    color: var(--on-dark);
    cursor: pointer;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }
  .hero-arrow:hover { background: rgba(20, 16, 11, 0.55); border-color: var(--gold); }
  @media (max-width: 640px) { .hero-arrows { display: none; } }

  /* ---------- SEKCJA REDAKCYJNA ---------- */
  .editorial {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: clamp(32px, 5vw, 88px);
    align-items: start;
  }
  @media (max-width: 960px) { .editorial { grid-template-columns: 1fr; } }
  .editorial-lead { margin-top: 1.8rem; max-width: 48ch; }
  .editorial-text .link-arrow { margin-top: 1.6rem; }

  .editorial-figure {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-top: clamp(40px, 5vw, 72px);
    padding-top: clamp(32px, 4vw, 48px);
    border-top: 1px solid var(--line);
  }
  .editorial-figure-num {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(4.5rem, 9vw, 8rem);
    line-height: 0.8;
    letter-spacing: -0.05em;
    color: var(--gold);
  }
  .editorial-figure-desc { font-size: clamp(1.05rem, 1.4vw, 1.3rem); color: var(--ink-90); margin: 0; }
  .editorial-figure-desc strong { font-weight: 700; }

  .editorial-media { display: grid; gap: clamp(18px, 2vw, 28px); }
  .editorial-tall { margin: 0; }
  .editorial-wide { margin: 0; margin-left: clamp(24px, 6vw, 72px); }
  .media-caption {
    margin-top: 10px;
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent-deep);
  }
  @media (max-width: 960px) { .editorial-wide { margin-left: 0; } }

  /* ---------- Nagłówki sekcji ---------- */
  .split-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    flex-wrap: wrap;
    max-width: none;
  }

  /* ---------- PAKIETY ---------- */
  .pkg-path { margin-top: clamp(40px, 5vw, 72px); }
  .pkg-path-head {
    display: flex;
    align-items: baseline;
    gap: 18px;
    flex-wrap: wrap;
    margin-bottom: clamp(20px, 2.5vw, 32px);
    padding-bottom: 16px;
    border-bottom: 1px solid var(--line);
  }
  .pkg-path-tag {
    font-size: 0.7rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--accent-deep);
  }
  .pkg-cta-row { display: flex; gap: 14px; flex-wrap: wrap; margin-top: clamp(40px, 5vw, 64px); }

  /* ---------- INWESTORZY ---------- */
  .investor {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: clamp(28px, 5vw, 80px);
    align-items: start;
  }
  @media (max-width: 900px) { .investor { grid-template-columns: 1fr; } }
  .investor-points {
    list-style: none;
    margin: 1.6rem 0 2.2rem;
    padding: 0;
    display: grid;
    gap: 14px;
  }
  .investor-points li { position: relative; padding-left: 26px; color: var(--on-dark); }
  .investor-points li::before {
    content: '';
    position: absolute; left: 0; top: 0.55em;
    width: 9px; height: 9px; background: var(--gold); transform: rotate(45deg);
  }

  /* ---------- KOŃCOWE CTA ---------- */
  .final-cta-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(28px, 5vw, 80px);
    align-items: center;
  }
  @media (max-width: 900px) { .final-cta-inner { grid-template-columns: 1fr; } }
  .final-cta-side .lead { max-width: 44ch; }
  .final-cta-actions { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 1.6rem; }
</style>

<script>
  // Hero slider — crossfade, sterowanie strzałkami/kropkami/klawiaturą, delikatny autoplay.
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero) {
    const slides = Array.from(hero.querySelectorAll<HTMLElement>('[data-hero-slide]'));
    const dots = Array.from(hero.querySelectorAll<HTMLButtonElement>('[data-hero-dot]'));
    const prev = hero.querySelector<HTMLButtonElement>('[data-hero-prev]');
    const next = hero.querySelector<HTMLButtonElement>('[data-hero-next]');
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (slides.length > 1) {
      let current = 0;
      let timer: number | undefined;

      // Pierwszy slajd ładuje się eager; pozostałe dociągamy dopiero po pierwszym renderze,
      // aby nie obciążać startu, zachowując płynność pierwszego przejścia.
      const preloadRest = () => {
        slides.forEach((slide, i) => {
          if (i === 0) return;
          const img = slide.querySelector<HTMLImageElement>('img');
          if (img && !img.complete) {
            const pre = new Image();
            pre.src = img.currentSrc || img.src;
          }
        });
      };
      if (document.readyState === 'complete') preloadRest();
      else window.addEventListener('load', preloadRest, { once: true });

      const show = (index: number) => {
        current = (index + slides.length) % slides.length;
        slides.forEach((slide, i) => {
          slide.toggleAttribute('data-active', i === current);
          const img = slide.querySelector('img');
          if (img) img.setAttribute('aria-hidden', i === current ? 'false' : 'true');
        });
        dots.forEach((dot, i) => {
          dot.toggleAttribute('data-active', i === current);
          dot.setAttribute('aria-selected', i === current ? 'true' : 'false');
        });
      };

      const go = (delta: number) => { show(current + delta); restart(); };

      const restart = () => {
        if (prefersReduced) return;
        if (timer) window.clearInterval(timer);
        timer = window.setInterval(() => show(current + 1), 6500);
      };

      prev?.addEventListener('click', () => go(-1));
      next?.addEventListener('click', () => go(1));
      dots.forEach((dot, i) => dot.addEventListener('click', () => { show(i); restart(); }));

      hero.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') go(-1);
        else if (e.key === 'ArrowRight') go(1);
      });

      // Wstrzymaj autoplay przy najechaniu / ukryciu karty.
      hero.addEventListener('mouseenter', () => timer && window.clearInterval(timer));
      hero.addEventListener('mouseleave', restart);
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) { if (timer) window.clearInterval(timer); }
        else restart();
      });

      restart();
    }
  }
</script>
