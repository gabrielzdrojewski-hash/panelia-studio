---
import type { PackageBand } from '../data/packageBands';
import EditorialImage from './EditorialImage.astro';

interface Props {
  band: PackageBand;
}
const { band } = Astro.props;

const ctaClass: Record<string, string> = {
  solid: 'btn',
  ghost: 'btn btn-ghost',
  gold: 'btn btn-gold',
};
---

<article class:list={['band', `band-${band.variant}`]} data-reveal>
  <div class="band-head">
    <span class="band-num">{band.number}</span>
    <div class="band-id">
      {band.label && <span class="band-label">{band.label}</span>}
      <span class="band-short">{band.short}</span>
      <h3 class="band-name">{band.name}</h3>
      <p class="band-positioning">{band.positioning}</p>
    </div>
  </div>

  <div class="band-right">
    {
      band.imageId && (
        <figure class="band-media">
          <EditorialImage
            id={band.imageId}
            ratio="16/9"
            hoverable
            showLabel
            sizes="(max-width: 860px) 100vw, 42vw"
          />
        </figure>
      )
    }

    <p class="band-audience"><span class="band-audience-label">Dla kogo</span>{band.audience}</p>

    <ul class="band-highlights">
      {band.highlights.map((item) => <li>{item}</li>)}
    </ul>

    {band.meta && <p class="band-meta">{band.meta}</p>}
    {band.notInclude && <p class="band-notinc">{band.notInclude}</p>}
    {band.note && <p class="band-note">{band.note}</p>}
  </div>

  <div class="band-ctas">
    {band.ctas.map((cta) => <a href={cta.href} class={ctaClass[cta.style]}>{cta.label}</a>)}
  </div>
</article>

<style>
  .band {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    grid-template-areas: 'head right' 'cta right';
    column-gap: clamp(24px, 3.4vw, 60px);
    row-gap: clamp(16px, 2vw, 26px);
    border-radius: var(--radius-lg);
    padding: clamp(24px, 3vw, 48px);
    align-items: start;
  }
  @media (max-width: 860px) {
    .band {
      grid-template-columns: 1fr;
      grid-template-areas: 'head' 'right' 'cta';
      row-gap: clamp(22px, 5vw, 32px);
    }
  }

  .band-head { grid-area: head; display: flex; flex-direction: column; gap: clamp(10px, 1.4vw, 18px); }
  .band-num {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.6rem, 5vw, 4.75rem);
    line-height: 0.8;
    letter-spacing: -0.05em;
    color: var(--gold);
  }
  .band-label {
    display: inline-block;
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--accent-deep);
    padding: 0.5em 0.9em;
    border: 1px solid var(--gold);
    border-radius: 999px;
    margin-bottom: 0.8rem;
  }
  .band-short {
    display: block;
    font-size: 0.75rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--accent-deep);
    margin-bottom: 0.4rem;
  }
  .band-name {
    font-size: clamp(1.8rem, 3vw, 2.8rem);
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .band-positioning { font-size: clamp(1.05rem, 1.4vw, 1.25rem); color: var(--ink-90); margin: 0.9rem 0 0; }
  .band-ctas { grid-area: cta; display: flex; flex-direction: column; align-items: flex-start; gap: 12px; }

  .band-right { grid-area: right; display: flex; flex-direction: column; gap: clamp(16px, 2vw, 24px); }
  .band-media { margin: 0; }
  .band-media-cap {
    margin-top: 10px;
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent-deep);
  }
  .band-audience { margin: 0; font-size: 1rem; line-height: 1.6; color: var(--ink-90); }
  .band-audience-label {
    display: block;
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--accent-deep);
    margin-bottom: 0.5rem;
  }

  .band-highlights {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 11px 30px;
  }
  @media (max-width: 560px) { .band-highlights { grid-template-columns: 1fr; } }
  .band-highlights li {
    position: relative;
    padding-left: 22px;
    font-size: 0.96rem;
    line-height: 1.5;
    color: var(--ink-90);
  }
  .band-highlights li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 7px;
    height: 7px;
    background: var(--gold);
    transform: rotate(45deg);
  }

  .band-meta {
    margin: 0;
    font-size: 0.9rem;
    letter-spacing: 0.02em;
    color: var(--accent-deep);
    font-weight: 600;
  }
  .band-notinc { margin: 0; font-size: 0.92rem; color: var(--muted); }
  .band-note {
    margin: 0;
    font-size: 0.88rem;
    color: var(--muted);
    border-left: 2px solid var(--gold);
    padding-left: 16px;
  }

  /* ——— Warianty (hierarchia) ——— */
  .band-light { background: var(--surface); border: 1px solid var(--line); }
  .band-warm { background: color-mix(in srgb, var(--gold) 5%, var(--surface)); border: 1px solid var(--line); }
  .band-signature {
    background: color-mix(in srgb, var(--gold) 8%, var(--surface));
    border: 1px solid var(--gold);
  }

  /* PREMIUM — ciemny, najmocniejszy, wyższy */
  .band-dark {
    background: var(--dark);
    color: var(--on-dark);
    padding: clamp(28px, 3.8vw, 60px);
  }
  .band-dark .band-name { color: #fff; }
  .band-dark .band-positioning { color: var(--on-dark); }
  .band-dark .band-short,
  .band-dark .band-audience-label,
  .band-dark .band-meta { color: var(--on-dark-gold); }
  .band-dark .band-label { color: var(--on-dark-gold); border-color: var(--gold); }
  .band-dark .band-audience { color: var(--on-dark); }
  .band-dark .band-highlights li { color: var(--on-dark); }
  .band-dark .band-notinc { color: var(--on-dark-muted); }
  .band-dark .band-note { color: var(--on-dark-muted); }
  .band-dark .btn-ghost { color: var(--on-dark); border-color: rgba(243, 239, 230, 0.35); }
  .band-dark .btn-ghost:hover { background: var(--on-dark); color: var(--dark); border-color: var(--on-dark); }
</style>
