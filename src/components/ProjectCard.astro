---
import type { Project } from '../data/projects';
import { getByCollection, getMediaById } from '../lib/media';

interface Props {
  project: Project;
  index: number;
}
const { project, index } = Astro.props;

const cover = getMediaById(project.coverId)!;
const photoCount = getByCollection('realization', project.realizationCollection).length;
const hasViz = Boolean(project.visualizationCollection);
const href = `/realizacje/${project.slug}`;
---

<a
  href={href}
  class="project-card"
  data-reveal
  aria-label={`Zobacz realizację: ${project.name}`}
>
  <div class="project-media">
    <img
      src={cover.path}
      alt={cover.alt}
      width={cover.width}
      height={cover.height}
      loading={index === 0 ? 'eager' : 'lazy'}
      decoding="async"
      sizes="(max-width: 1000px) 100vw, 90vw"
    />
    <span class="badge project-badge">Realizacja</span>
    <span class="project-gradient" aria-hidden="true"></span>

    <div class="project-overlay">
      <div class="project-overlay-main">
        <p class="project-location">{project.location}</p>
        <h3 class="project-name">{project.name}</h3>
        <p class="project-summary">{project.summary}</p>
      </div>
      <div class="project-overlay-side">
        <ul class="project-meta">
          <li>{photoCount} zdjęć z realizacji</li>
          {hasViz && <li>Wizualizacje projektowe</li>}
        </ul>
        <span class="link-arrow project-link">Zobacz realizację</span>
      </div>
    </div>
  </div>
</a>

<style>
  .project-card { display: block; }

  .project-media {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--line);
    aspect-ratio: 16 / 10;
  }
  @media (min-width: 1000px) { .project-media { aspect-ratio: 21 / 9; } }
  .project-media img {
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 1.1s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .project-card:hover .project-media img { transform: scale(1.04); }

  .project-badge {
    position: absolute; left: 18px; top: 18px; z-index: 2;
    background: color-mix(in srgb, var(--surface) 88%, transparent);
    backdrop-filter: blur(4px);
  }

  /* Gradient tylko pod tekstem (dolna część) */
  .project-gradient {
    position: absolute; inset: 0; z-index: 1;
    background: linear-gradient(0deg, rgba(15, 13, 9, 0.82) 0%, rgba(15, 13, 9, 0.35) 22%, transparent 52%);
  }

  .project-overlay {
    position: absolute; z-index: 2;
    left: 0; right: 0; bottom: 0;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 28px;
    flex-wrap: wrap;
    padding: clamp(24px, 3.5vw, 52px);
    color: var(--on-dark);
  }
  .project-location {
    font-size: 0.74rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--on-dark-gold);
    margin: 0 0 0.7rem;
  }
  .project-name { color: #fff; font-size: clamp(2rem, 4.5vw, 3.6rem); margin: 0; }
  .project-summary { color: rgba(243, 239, 230, 0.9); max-width: 46ch; margin: 0.8rem 0 0; }

  .project-overlay-side { display: flex; flex-direction: column; align-items: flex-start; gap: 16px; }
  .project-meta {
    list-style: none; margin: 0; padding: 0;
    display: flex; flex-wrap: wrap; gap: 10px;
  }
  .project-meta li {
    font-size: 0.74rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--on-dark);
    padding: 0.5em 0.95em;
    border: 1px solid rgba(243, 239, 230, 0.3);
    border-radius: 999px;
  }
  .project-link { color: var(--on-dark); }
  .project-card:hover .project-link { gap: 0.9em; border-color: var(--gold); }

  @media (max-width: 720px) {
    .project-media { aspect-ratio: 4 / 5; }
    .project-summary { display: none; }
  }
</style>
