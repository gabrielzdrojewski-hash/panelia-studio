---
import type { ProcessStep } from '../data/process';

interface Props {
  steps: ProcessStep[];
}
const { steps } = Astro.props;
---

<ol class="timeline">
  {
    steps.map((step, index) => (
      <li class="timeline-step" data-reveal style={`--reveal-delay: ${(index % 2) * 90}ms`}>
        <span class="timeline-number">{step.number}</span>
        <div class="timeline-body">
          <h3 class="timeline-title">{step.title}</h3>
          <p class="timeline-desc muted">{step.description}</p>
        </div>
      </li>
    ))
  }
</ol>

<style>
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
  }
  @media (max-width: 720px) { .timeline { grid-template-columns: 1fr; } }

  .timeline-step {
    display: flex;
    gap: 22px;
    padding: clamp(24px, 3vw, 34px) clamp(20px, 3vw, 40px);
    border-top: 1px solid var(--line);
    border-right: 1px solid var(--line);
  }
  /* Usuń prawą krawędź w drugiej kolumnie */
  .timeline-step:nth-child(2n) { border-right: 0; }
  @media (max-width: 720px) {
    .timeline-step { border-right: 0; }
  }

  .timeline-number {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    color: var(--accent);
    line-height: 1;
    flex-shrink: 0;
    min-width: 1.8em;
  }
  .timeline-title { font-size: clamp(1.2rem, 1.8vw, 1.45rem); margin-bottom: 8px; }
  .timeline-desc { font-size: 0.95rem; }
</style>
