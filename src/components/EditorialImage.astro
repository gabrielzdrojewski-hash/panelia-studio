---
import { getEditorial, editorialSrcset } from '../data/editorialMedia';

interface Props {
  id: string;
  ratio?: string; // np. "16/9"
  sizes?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'auto';
  showLabel?: boolean; // dyskretna etykieta „Wizualizacja koncepcyjna”
  hoverable?: boolean;
  class?: string;
}

const {
  id,
  ratio = '16/9',
  sizes = '(max-width: 900px) 100vw, 40vw',
  loading = 'lazy',
  fetchpriority,
  showLabel = false,
  hoverable = false,
  class: className,
} = Astro.props;

const media = getEditorial(id);
---

{
  media && (
    <div
      class:list={['editorial-img', 'media-frame', { hoverable }, className]}
      style={`aspect-ratio: ${ratio};`}
    >
      <img
        src={media.src}
        srcset={editorialSrcset(media)}
        sizes={sizes}
        width={media.width}
        height={media.height}
        alt={media.alt}
        loading={loading}
        fetchpriority={fetchpriority}
        decoding="async"
        style={`object-position: ${media.focalPoint};`}
      />
      {showLabel && <span class="editorial-tag">{media.publicLabel}</span>}
    </div>
  )
}

<style>
  .editorial-img { position: relative; }
  .editorial-tag {
    position: absolute;
    left: 12px;
    bottom: 12px;
    z-index: 2;
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--on-dark);
    background: rgba(20, 16, 11, 0.55);
    backdrop-filter: blur(4px);
    padding: 0.45em 0.8em;
    border-radius: 999px;
  }
</style>
