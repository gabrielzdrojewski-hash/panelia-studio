---
import type { Package } from '../data/packages';
import { getProfile, confirmNote, carbonHighlight } from '../data/materialStandards';

interface Props {
  pkg: Package;
  index: number;
}
const { pkg, index } = Astro.props;
const number = String(index + 1).padStart(2, '0');
const notIncludedLabel = pkg.notIncludedLabel ?? 'Nie obejmuje';
const isInfoNote = pkg.notIncludedLabel === 'Ważne';

// Profil materiałowy tylko dla pakietów wykończeniowych (start/comfort/premium).
const profile = getProfile(pkg.slug);
const showCarbon = pkg.slug === 'premium';
const showConfirmNote = pkg.slug === 'comfort' || pkg.slug === 'premium';
---

<article class="pkg" id={pkg.slug} data-reveal>
  <div class="pkg-side">
    <span class="pkg-num">{number}</span>
    <span class="pkg-short">{pkg.short}</span>
    <h3 class="pkg-name">{pkg.name}</h3>
    <p class="pkg-kind">{pkg.kind}</p>
    <p class="pkg-audience">{pkg.audience}</p>
    <div class="pkg-actions">
      <a href={`/kontakt?pakiet=${pkg.formValue}`} class="btn btn-ghost pkg-cta">Zapytaj o pakiet</a>
      {profile && (
        <a href={`#materialy-${pkg.slug}`} class="btn btn-gold pkg-materials-btn">
          Zobacz materiały w {profile.short}
        </a>
      )}
    </div>
  </div>

  <div class="pkg-main">
    <div class="pkg-part">
      <span class="pkg-label">Zakres</span>
      {pkg.scopeIntro && <p class="pkg-scope-intro">{pkg.scopeIntro}</p>}
      <ul class="pkg-list pkg-list-check">
        {pkg.scope.map((item) => <li>{item}</li>)}
      </ul>
    </div>

    {
      profile && (
        <div class="pkg-part pkg-part-material">
          <span class="pkg-label">Standard materiałowy</span>
          <h4 class="pkg-material-heading">{profile.heading}</h4>
          <ul class="pkg-list pkg-list-check">
            {profile.points.map((item) => <li>{item}</li>)}
          </ul>
          {showConfirmNote && <p class="pkg-material-note">{confirmNote}</p>}

          {showCarbon && (
            <div class="pkg-carbon">
              <span class="pkg-carbon-title">{carbonHighlight.title}</span>
              <ul class="pkg-list pkg-list-check pkg-carbon-list">
                {carbonHighlight.points.map((point) => <li>{point}</li>)}
              </ul>
              <p class="pkg-carbon-note">{carbonHighlight.note}</p>
            </div>
          )}
        </div>
      )
    }

    {
      pkg.revisions && (
        <div class="pkg-part">
          <span class="pkg-label">Rundy zmian</span>
          <ul class="pkg-list pkg-list-rev">
            {pkg.revisions.map((rev) => (
              <li>
                <span>{rev.label}</span>
                <span class="pkg-rev-val">{rev.value}</span>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    {
      pkg.notIncluded && (
        <div class:list={['pkg-part', { 'pkg-part-info': isInfoNote }]}>
          <span class="pkg-label">{notIncludedLabel}</span>
          <ul class:list={['pkg-list', isInfoNote ? 'pkg-list-info' : 'pkg-list-minus']}>
            {pkg.notIncluded.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      )
    }

    {
      pkg.notes && (
        <div class="pkg-notes">
          {pkg.notes.map((note) => <p>{note}</p>)}
        </div>
      )
    }
  </div>
</article>

<style>
  .pkg {
    display: grid;
    grid-template-columns: 4fr 8fr;
    gap: clamp(28px, 4vw, 72px);
    padding-block: clamp(48px, 6vw, 92px);
    border-top: 1px solid var(--line);
    align-items: start;
  }
  .pkg:first-of-type { border-top: 0; }

  /* Lewa kolumna — sticky na desktopie */
  .pkg-side { display: flex; flex-direction: column; }
  @media (min-width: 961px) {
    .pkg-side { position: sticky; top: 108px; }
  }
  .pkg-num {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.4rem, 4vw, 3.4rem);
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: var(--gold);
    margin-bottom: 0.6rem;
  }
  .pkg-short {
    font-size: 0.72rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--accent-deep);
  }
  .pkg-name { font-size: clamp(2rem, 3.4vw, 3rem); margin-top: 6px; }
  .pkg-kind { font-size: 0.92rem; color: var(--muted); margin: 10px 0 0; }
  .pkg-audience {
    font-size: 1.02rem;
    line-height: 1.6;
    color: var(--ink-90);
    margin: 1.3rem 0 0;
    max-width: 42ch;
  }
  .pkg-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    margin-top: 1.8rem;
  }
  .pkg-cta,
  .pkg-materials-btn { align-self: flex-start; }

  /* Prawa kolumna */
  .pkg-main { display: flex; flex-direction: column; gap: clamp(28px, 3.5vw, 48px); }
  .pkg-part { }
  .pkg-part-info {
    background: color-mix(in srgb, var(--gold) 9%, var(--surface));
    border: 1px solid var(--gold);
    border-radius: var(--radius-lg);
    padding: clamp(22px, 2.5vw, 32px);
  }

  /* Standard materiałowy + wyróżnik paneli węglowych */
  .pkg-material-heading {
    font-size: clamp(1.15rem, 1.7vw, 1.45rem);
    margin: -0.3rem 0 1.1rem;
    color: var(--ink);
  }
  .pkg-material-note { margin-top: 1.1rem; font-size: 0.9rem; color: var(--muted); }
  .pkg-carbon {
    margin-top: clamp(20px, 2.5vw, 28px);
    padding: clamp(20px, 2.5vw, 30px);
    background: color-mix(in srgb, var(--gold) 10%, var(--surface));
    border: 1px solid var(--gold);
    border-radius: var(--radius-lg);
  }
  .pkg-carbon-title {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.1rem, 1.6vw, 1.35rem);
    letter-spacing: -0.02em;
    color: var(--ink);
    margin-bottom: 1.1rem;
  }
  .pkg-carbon-note { margin: 1.1rem 0 0; font-size: 0.9rem; color: var(--muted); }

  .pkg-label {
    display: block;
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--accent-deep);
    margin-bottom: 1.2rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--line);
  }
  .pkg-part-info .pkg-label { border-bottom-color: color-mix(in srgb, var(--gold) 40%, transparent); }
  .pkg-scope-intro { font-size: 1rem; color: var(--muted); margin: -0.4rem 0 1.3rem; }

  .pkg-list { list-style: none; margin: 0; padding: 0; }
  .pkg-list-check {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px 40px;
  }
  @media (max-width: 620px) { .pkg-list-check { grid-template-columns: 1fr; } }
  .pkg-list-check li,
  .pkg-list-minus li,
  .pkg-list-info li {
    position: relative;
    padding-left: 28px;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--ink-90);
  }
  .pkg-list-check li::before { content: '✓'; position: absolute; left: 0; top: 0; color: var(--accent-deep); font-weight: 700; }

  .pkg-list-minus { display: flex; flex-direction: column; gap: 12px; }
  .pkg-list-minus li { color: var(--muted); }
  .pkg-list-minus li::before { content: '–'; position: absolute; left: 0; top: 0; color: var(--muted); }

  .pkg-list-info { display: flex; flex-direction: column; gap: 12px; }
  .pkg-list-info li::before { content: '!'; position: absolute; left: 0; top: 0; color: var(--accent-deep); font-weight: 700; }

  .pkg-list-rev { display: flex; flex-direction: column; }
  .pkg-list-rev li {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 13px 0;
    border-bottom: 1px solid var(--line);
    font-size: 1rem;
  }
  .pkg-list-rev li:last-child { border-bottom: 0; }
  .pkg-rev-val { color: var(--accent-deep); font-weight: 700; white-space: nowrap; }

  .pkg-notes { border-left: 2px solid var(--gold); padding: 6px 0 6px 22px; }
  .pkg-notes p { font-size: 0.98rem; color: var(--muted); margin: 0 0 0.7em; }
  .pkg-notes p:last-child { margin-bottom: 0; }

  @media (max-width: 960px) {
    .pkg { grid-template-columns: 1fr; gap: 28px; }
  }
</style>
