---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
}
const { eyebrow, title, lead } = Astro.props;
---

<section class="page-hero">
  <div class="container">
    {eyebrow && <p class="eyebrow" data-reveal>{eyebrow}</p>}
    <h1 class="page-hero-title" data-reveal style="--reveal-delay: 60ms">{title}</h1>
    {lead && <p class="lead muted page-hero-lead" data-reveal style="--reveal-delay: 120ms">{lead}</p>}
  </div>
</section>

<style>
  .page-hero {
    padding-top: clamp(44px, 5.5vw, 84px);
    padding-bottom: clamp(24px, 3vw, 44px);
  }
  .page-hero-title {
    /* RC polish: −~10% (82→74px @1920), do 3 linii, węższy blok */
    font-size: clamp(2.5rem, 4.8vw, 4.6rem);
    line-height: 0.94;
    max-width: 20ch;
  }
  .page-hero-lead { margin-top: 1.4rem; max-width: 56ch; }
  @media (max-width: 640px) {
    .page-hero-title { font-size: clamp(2.6rem, 11vw, 3.1rem); } /* ~42–50px, naturalne łamanie */
  }
</style>
