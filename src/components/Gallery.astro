---
import type { MediaItem } from '../lib/media';

interface Props {
  id: string; // Stabilny identyfikator galerii (potrzebny lightboxowi).
  items: MediaItem[];
  badge?: string; // Etykieta typu, np. „Realizacja” / „Wizualizacja projektowa”.
  badgeViz?: boolean; // Styl odznaki dla wizualizacji.
  columns?: number;
}

const { id, items, badge, badgeViz = false, columns = 3 } = Astro.props;
---

<div class="gallery" data-gallery={id} style={`--cols: ${columns};`}>
  {
    items.map((item, index) => (
      <figure class="gallery-item">
        <button
          type="button"
          class="gallery-trigger media-frame hoverable"
          data-index={index}
          aria-label={`Powiększ: ${item.title}`}
          style={`aspect-ratio: ${item.width} / ${item.height};`}
        >
          <img
            src={item.path}
            alt={item.alt}
            width={item.width}
            height={item.height}
            loading="lazy"
            decoding="async"
            sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 33vw"
          />
          {badge && <span class:list={['badge', 'gallery-badge', { 'badge-viz': badgeViz }]}>{badge}</span>}
        </button>
      </figure>
    ))
  }
</div>

<!-- Lightbox -->
<div
  class="lightbox"
  data-lightbox={id}
  role="dialog"
  aria-modal="true"
  aria-label="Podgląd zdjęcia"
  hidden
>
  <div class="lightbox-bar">
    <span class="lightbox-counter" data-lb-counter></span>
    <button type="button" class="lightbox-btn lightbox-close" data-lb-close aria-label="Zamknij podgląd">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
    </button>
  </div>
  <button type="button" class="lightbox-nav lightbox-prev" data-lb-prev aria-label="Poprzednie zdjęcie">
    <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
  </button>
  <figure class="lightbox-stage">
    <img data-lb-image src="" alt="" />
    <figcaption class="lightbox-caption" data-lb-caption></figcaption>
  </figure>
  <button type="button" class="lightbox-nav lightbox-next" data-lb-next aria-label="Następne zdjęcie">
    <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
  </button>
</div>

<script
  is:inline
  type="application/json"
  data-gallery-data={id}
  set:html={JSON.stringify(
    items.map((item) => ({ src: item.path, alt: item.alt, title: item.title })),
  )}
/>

<style>
  /* Układ kolumnowy — dobrze radzi sobie z różnymi proporcjami zdjęć */
  .gallery {
    column-count: var(--cols);
    column-gap: clamp(14px, 1.6vw, 26px);
  }
  @media (max-width: 1100px) { .gallery { column-count: 2; } }
  @media (max-width: 640px) { .gallery { column-count: 1; } }

  .gallery-item {
    margin: 0 0 clamp(14px, 1.6vw, 26px);
    break-inside: avoid;
  }
  .gallery-trigger {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    cursor: pointer;
    background: var(--line);
    position: relative;
  }
  .gallery-badge {
    position: absolute;
    left: 12px;
    top: 12px;
    background: color-mix(in srgb, var(--surface) 90%, transparent);
    backdrop-filter: blur(4px);
  }

  /* Lightbox */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-rows: auto 1fr;
    align-items: center;
    gap: 8px;
    padding: clamp(12px, 3vw, 32px);
    background: rgba(15, 13, 9, 0.94);
    backdrop-filter: blur(6px);
  }
  .lightbox[hidden] { display: none; }

  .lightbox-bar {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--on-dark-muted);
  }
  .lightbox-counter {
    font-size: 0.8rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .lightbox-btn,
  .lightbox-nav {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid transparent;
    color: var(--on-dark);
    cursor: pointer;
    border-radius: 999px;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }
  .lightbox-close { width: 46px; height: 46px; }
  .lightbox-nav { width: 56px; height: 56px; }
  .lightbox-btn:hover,
  .lightbox-nav:hover { background: rgba(243, 239, 230, 0.12); border-color: rgba(243, 239, 230, 0.3); }

  .lightbox-stage {
    grid-column: 2;
    grid-row: 2;
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 0;
    gap: 14px;
  }
  .lightbox-stage img {
    max-width: 100%;
    max-height: 76vh;
    width: auto;
    height: auto;
    object-fit: contain;
    box-shadow: 0 30px 80px -30px rgba(0, 0, 0, 0.8);
  }
  .lightbox-caption {
    color: var(--on-dark-muted);
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    text-align: center;
  }
  .lightbox-prev { grid-column: 1; grid-row: 2; }
  .lightbox-next { grid-column: 3; grid-row: 2; }

  @media (max-width: 640px) {
    .lightbox-nav { width: 44px; height: 44px; }
    .lightbox-stage img { max-height: 68vh; }
  }
</style>

<script>
  interface Slide {
    src: string;
    alt: string;
    title: string;
  }

  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
    const id = gallery.getAttribute('data-gallery');
    if (!id) return;

    const dataEl = document.querySelector<HTMLScriptElement>(`[data-gallery-data="${id}"]`);
    const lightbox = document.querySelector<HTMLElement>(`[data-lightbox="${id}"]`);
    if (!dataEl || !lightbox) return;

    let slides: Slide[] = [];
    try {
      slides = JSON.parse(dataEl.textContent || '[]');
    } catch {
      slides = [];
    }

    const image = lightbox.querySelector<HTMLImageElement>('[data-lb-image]');
    const caption = lightbox.querySelector<HTMLElement>('[data-lb-caption]');
    const counter = lightbox.querySelector<HTMLElement>('[data-lb-counter]');
    const btnClose = lightbox.querySelector<HTMLButtonElement>('[data-lb-close]');
    const btnPrev = lightbox.querySelector<HTMLButtonElement>('[data-lb-prev]');
    const btnNext = lightbox.querySelector<HTMLButtonElement>('[data-lb-next]');

    let current = 0;
    let lastFocused: HTMLElement | null = null;

    const render = () => {
      const slide = slides[current];
      if (!slide || !image) return;
      image.src = slide.src;
      image.alt = slide.alt;
      if (caption) caption.textContent = slide.title;
      if (counter) counter.textContent = `${current + 1} / ${slides.length}`;
    };

    const open = (index: number) => {
      current = index;
      lastFocused = document.activeElement as HTMLElement;
      render();
      lightbox.hidden = false;
      document.body.style.overflow = 'hidden';
      btnClose?.focus();
    };

    const close = () => {
      lightbox.hidden = true;
      document.body.style.overflow = '';
      lastFocused?.focus();
    };

    const go = (delta: number) => {
      current = (current + delta + slides.length) % slides.length;
      render();
    };

    gallery.querySelectorAll<HTMLButtonElement>('[data-index]').forEach((trigger) => {
      trigger.addEventListener('click', () => {
        open(Number(trigger.getAttribute('data-index')));
      });
    });

    btnClose?.addEventListener('click', close);
    btnPrev?.addEventListener('click', () => go(-1));
    btnNext?.addEventListener('click', () => go(1));
    lightbox.addEventListener('click', (event) => {
      if (event.target === lightbox) close();
    });

    document.addEventListener('keydown', (event) => {
      if (lightbox.hidden) return;
      if (event.key === 'Escape') close();
      else if (event.key === 'ArrowLeft') go(-1);
      else if (event.key === 'ArrowRight') go(1);
    });
  });
</script>
