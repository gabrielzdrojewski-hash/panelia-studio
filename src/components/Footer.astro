---
import Logo from './Logo.astro';
import { contact, secondaryNav, social } from '../data/site';
import { getMediaById } from '../lib/media';

// Tło stopki — dekoracyjna wizualizacja marki (inna niż hero strony głównej).
// NIE przedstawiamy jej jako wykonanej realizacji (puste alt, brak podpisu).
const bg = getMediaById('visualization-ustronie-07')!;

const year = new Date().getFullYear();
---

<footer class="site-footer" data-footer>
  <img
    class="footer-bg"
    src={bg.path}
    alt=""
    width={bg.width}
    height={bg.height}
    loading="lazy"
    decoding="async"
    aria-hidden="true"
  />
  <span class="footer-overlay" aria-hidden="true"></span>
  <span class="footer-word" aria-hidden="true">PANELIA</span>

  <div class="container footer-inner">
    <div class="footer-toprow">
      <a href="/" class="footer-logo" aria-label="Panelia Studio — strona główna">
        <Logo variant="light" kind="full" width={300} />
      </a>
      <button type="button" class="to-top" data-to-top aria-label="Powrót na górę strony">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M12 19V5M6 11l6-6 6 6" />
        </svg>
      </button>
    </div>

    <div class="footer-grid">
      <div class="footer-brand">
        <p class="footer-tagline">Od projektu po realizację.</p>
        <p class="footer-sub">
          Projektujemy, dobieramy materiały i prowadzimy proces wykończenia wnętrza.
        </p>
        <address class="footer-address">
          {contact.address.street}<br />
          {contact.address.postalCode} {contact.address.city}
        </address>
      </div>

      <div class="footer-contact">
        <span class="footer-label">Kontakt</span>
        <a href={`tel:${contact.phoneHref}`} class="footer-phone">{contact.phone}</a>
        <a href={`mailto:${contact.email}`} class="footer-email">{contact.email}</a>
        <a href="/kontakt" class="btn btn-gold footer-cta">Umów rozmowę</a>

        {
          social.length > 0 && (
            <ul class="footer-social">
              {social.map((item) => (
                <li>
                  <a href={item.href} target="_blank" rel="noopener noreferrer">{item.label}</a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </div>

    <hr class="footer-rule" />

    <div class="footer-bottom">
      <p class="footer-copy">© {year} Panelia Studio. Wszelkie prawa zastrzeżone.</p>
      <ul class="footer-legal">
        {secondaryNav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--dark);
    color: var(--on-dark);
    min-height: clamp(560px, 62vw, 780px);
    display: flex;
    align-items: stretch;
    padding-block: clamp(64px, 8vw, 120px) clamp(28px, 3vw, 44px);
  }

  /* Tło + overlay */
  .footer-bg {
    position: absolute;
    inset: 0;
    z-index: -3;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
  }
  .footer-overlay {
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      linear-gradient(180deg, rgba(20, 15, 10, 0.9) 0%, rgba(20, 15, 10, 0.72) 32%, rgba(20, 15, 10, 0.88) 100%),
      linear-gradient(90deg, rgba(20, 15, 10, 0.85) 0%, rgba(20, 15, 10, 0.4) 60%, rgba(20, 15, 10, 0.65) 100%);
  }

  /* Ogromny napis dekoracyjny — za treścią, subtelny, częściowo ucięty */
  .footer-word {
    position: absolute;
    z-index: -1;
    left: 50%;
    bottom: clamp(-0.16em, -2vw, -0.08em);
    transform: translateX(-50%);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(6rem, 30vw, 30rem);
    line-height: 0.8;
    letter-spacing: -0.05em;
    color: transparent;
    -webkit-text-stroke: 1.5px rgba(243, 239, 230, 0.1);
    white-space: nowrap;
    pointer-events: none;
    user-select: none;
  }

  .footer-inner {
    position: relative;
    z-index: 1;
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .footer-toprow { display: flex; justify-content: space-between; align-items: center; gap: 20px; }
  .footer-logo { display: block; line-height: 0; flex-shrink: 0; }
  /* :global — img renderowany jest przez komponent Logo (inny scope). */
  .footer-logo :global(img) { width: clamp(200px, 24vw, 320px); height: auto; max-width: 100%; }
  .to-top {
    width: 52px;
    height: 52px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    border: 1.5px solid rgba(243, 239, 230, 0.3);
    background: rgba(20, 16, 11, 0.32);
    backdrop-filter: blur(6px);
    color: var(--on-dark);
    cursor: pointer;
    transition: background-color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }
  .to-top:hover { background: var(--gold); border-color: var(--gold); color: var(--dark); transform: translateY(-2px); }

  /* Główny, asymetryczny układ */
  .footer-grid {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: clamp(40px, 6vw, 120px);
    align-items: start;
    margin-top: clamp(32px, 4vw, 56px);
    margin-bottom: clamp(80px, 12vw, 180px);
  }

  .footer-tagline {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.8rem, 3.2vw, 3rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    color: #fff;
    margin: 0 0 1rem;
  }
  .footer-sub { color: var(--on-dark-muted); max-width: 40ch; font-size: 1.05rem; margin: 0 0 1.6rem; }
  .footer-address {
    font-style: normal;
    color: var(--on-dark);
    line-height: 1.6;
    font-size: 1.05rem;
  }

  .footer-contact { display: flex; flex-direction: column; align-items: flex-start; gap: 14px; }
  .footer-label {
    font-size: 0.72rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--on-dark-gold);
    margin-bottom: 6px;
  }
  .footer-phone,
  .footer-email {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #fff;
    line-height: 1.05;
    transition: color 0.2s ease;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  .footer-phone { font-size: clamp(1.9rem, 3.6vw, 3.1rem); }
  .footer-email { font-size: clamp(1.25rem, 2.2vw, 1.9rem); word-break: break-word; }
  .footer-phone:hover,
  .footer-email:hover { color: var(--gold); }
  .footer-cta { margin-top: 10px; }

  .footer-social {
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
  }
  .footer-social a {
    color: var(--on-dark-muted);
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-bottom: 1px solid transparent;
    padding-bottom: 2px;
    transition: color 0.2s ease, border-color 0.2s ease;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  .footer-social a:hover { color: var(--gold); border-color: var(--gold); }

  .footer-rule {
    border: 0;
    border-top: 1px solid rgba(243, 239, 230, 0.16);
    margin: 0 0 24px;
  }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px 28px;
    flex-wrap: wrap;
    font-size: 0.9rem;
  }
  .footer-copy { color: var(--on-dark-muted); margin: 0; }
  .footer-legal { list-style: none; display: flex; gap: 24px; margin: 0; padding: 0; }
  .footer-legal a {
    color: var(--on-dark-muted);
    transition: color 0.2s ease;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  .footer-legal a:hover { color: var(--gold); }

  @media (max-width: 860px) {
    .site-footer { min-height: 0; }
    .footer-grid {
      grid-template-columns: 1fr;
      gap: clamp(32px, 8vw, 48px);
      margin-bottom: clamp(96px, 26vw, 150px);
    }
    .footer-word { font-size: clamp(5rem, 34vw, 12rem); bottom: -0.06em; }
    .footer-bottom { flex-direction: column; align-items: flex-start; }
  }
</style>

<script>
  const toTop = document.querySelector<HTMLButtonElement>('[data-to-top]');
  toTop?.addEventListener('click', () => {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
  });
</script>
