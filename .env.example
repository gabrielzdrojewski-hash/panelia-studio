# Panelia Studio — przykładowe zmienne środowiskowe.
# Skopiuj do `.env` (ignorowany przez Git) i uzupełnij WYŁĄCZNIE lokalnie/serwerowo.
# NIE wpisuj prawdziwego tokenu w tym pliku.

# --- Publiczne (dozwolone w bundlu klienta) ---
# Tylko ta flaga może mieć prefiks PUBLIC_. Kontroluje render HTML podczas builda Astro:
#   false = kontakt bezpośredni (produkcyjnie bezpieczny, domyślny)
#   true  = formularz + widoczny telefon/e-mail
PUBLIC_CONTACT_FORM_ENABLED=false

# --- Prywatne (NIGDY nie eksponowane w kliencie; używane przez gateway PHP na serwerze) ---
# Uwaga: PHP odczytuje konfigurację z getenv() lub z prywatnego pliku serwera
# (docs/examples/panelia-erp-config.php.example). Wartości poniżej to referencja —
# build Astro ich nie potrzebuje i nie może na nich polegać podczas requestu.
FATICA_ERP_PUBLIC_LEADS_URL=https://app.fatica.pl/api/public/leads
FATICA_ERP_PANELIA_TOKEN=
FATICA_ERP_REQUEST_TIMEOUT_MS=10000
# Mock aktywny tylko gdy JEDNOCZEŚNIE MOCK=true i ALLOW_MOCK=true (produkcyjnie oba false).
FATICA_ERP_CONTACT_MOCK=false
FATICA_ERP_CONTACT_ALLOW_MOCK=false
